# PostgreSQL (required)
DATABASE_USERNAME='postgres'
DATABASE_PASSWORD='change-me'
# Optional (defaults shown)
# DATABASE_NAME='fuel_route'
# DATABASE_HOST='localhost'
# DATABASE_PORT='5432'

# Django (optional)
# DJANGO_SECRET_KEY='set-a-long-random-string-in-production'
# DJANGO_DEBUG='true'
# DJANGO_ALLOWED_HOSTS='localhost,127.0.0.1'

# Planner tuning (optional, defaults shown)
# CORRIDOR_MILES=10
# ORIGIN_FUEL_RADIUS_MILES=30
# STOP_PENALTY_DOLLARS=5
# ROUTE_CACHE_SECONDS=86400

# Free map services (optional; point OSRM at a self-hosted server for production)
# OSRM_BASE_URL='https://router.project-osrm.org'
# NOMINATIM_BASE_URL='https://nominatim.openstreetmap.org'
# HTTP_USER_AGENT='fuel-route-optimizer/1.0'

# Map tiles for the /map/ page (optional; default is Esri World Street Map)
# MAP_TILE_URL='https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}'
# MAP_TILE_ATTRIBUTION='Tiles &copy; Esri'
